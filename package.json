{
  "name": "@lumina-layer-studio/fuse-bead-studio",
  "version": "1.0.9-dev.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest",
    "test:run": "vitest run",
    "package": "pnpm run test:run && pnpm run build && node --test test/inline-worker-build.test.mjs && node scripts/package.mjs && node --test test/package-output.test.mjs"
  },
  "dependencies": {
    "@lumina/workshop-sdk": "git+https://github.com/lumina-layer-studio/Lumina-Workshop-SDK.git#a681ab60f7a4223d9aa4d04a7886d8ccee2dffd6",
    "polygon-clipping": "0.15.7",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "three": "0.185.1"
  },
  "pnpm": { "onlyBuiltDependencies": ["@lumina/workshop-sdk", "esbuild"] },
  "devDependencies": {
    "@types/node": "22.15.30",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@types/three": "0.185.4",
    "@vitejs/plugin-react": "4.5.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "fast-check": "4.2.0",
    "fflate": "0.8.2",
    "jsdom": "26.1.0",
    "typescript": "5.8.3",
    "vite": "7.3.7",
    "vite-plugin-singlefile": "2.2.0",
    "vitest": "3.2.4"
  }
}
